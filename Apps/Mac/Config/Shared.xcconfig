// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Lumi
PRODUCT_DISPLAY_NAME = Lumi
PRODUCT_BUNDLE_IDENTIFIER = app.huanan.lumi
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 26.0
ALWAYS_SEARCH_USER_PATHS = NO

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = LumiMac/Info.plist
LUMI_RELAY_URL = https:/$()/relay.lumi.huanan.app
INFOPLIST_KEY_LumiRelayURL = $(LUMI_RELAY_URL)

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/LumiMac.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/LumiMac.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
