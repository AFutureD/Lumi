// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

#include "../../../Config/Version.xcconfig"

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Lumi
PRODUCT_DISPLAY_NAME = Lumi
PRODUCT_BUNDLE_IDENTIFIER = app.huanan.lumi

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 26.0
ALWAYS_SEARCH_USER_PATHS = NO
ARCHS = arm64
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = LumiMac/Info.plist
LUMI_RELAY_URL = https:/$()/relay.lumi.huanan.app
INFOPLIST_KEY_LumiRelayURL = $(LUMI_RELAY_URL)
// Must stay on the repository the release workflow publishes to; the validate job asserts parity with GITHUB_REPOSITORY.
LUMI_UPDATE_FEED_URL = https:/$()/github.com/AFutureD/Lumi/releases/latest/download/appcast.xml

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/LumiMac.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/LumiMac.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
