// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = AgentStatusMac
PRODUCT_DISPLAY_NAME = Agent Status
PRODUCT_BUNDLE_IDENTIFIER = com.huanan.AgentStatusMac
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 26.0
ALWAYS_SEARCH_USER_PATHS = NO

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = AgentStatusMac/Info.plist
AGENT_STATUS_RELAY_URL = https:/$()/agent-status-relay.afuture.workers.dev
INFOPLIST_KEY_AgentStatusRelayURL = $(AGENT_STATUS_RELAY_URL)

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/AgentStatusMac.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/AgentStatusMac.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
