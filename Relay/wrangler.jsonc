{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumi-relay",
  "main": "src/index.ts",
  // One public address. Pairing links carry it, so the workers.dev alias
  // stays off and the custom domain is the only way in.
  "workers_dev": false,
  "routes": [{ "pattern": "relay.lumi.huanan.app", "custom_domain": true }],
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  // Edge rate limit, checked in the Worker before any Durable Object is
  // reached: per client address (IPv6 per /64). Generous on purpose — a home
  // NAT with one Mac (device refresh every 10 s) and two iPhones pairing
  // (1 poll/s each) stays well under it; floods and host-ID sprawl do not.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_RELAY",
        "class_name": "HostRelay"
      },
      {
        "name": "PAIRING_DIRECTORY",
        "class_name": "PairingDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HostRelay"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PairingDirectory"]
    }
  ],
  // APNs credentials (key ID, team ID, .p8 private key) are secrets:
  // `wrangler secret put APNS_KEY_ID / APNS_TEAM_ID / APNS_PRIVATE_KEY`.
  // Never mirror them in "vars" — a var with the same name would overwrite
  // the secret on deploy. Declaring them here makes them the source of truth
  // for `wrangler types` (no .dev.vars needed in CI) and lets deploy verify
  // they are configured.
  "secrets": {
    "required": ["APNS_KEY_ID", "APNS_TEAM_ID", "APNS_PRIVATE_KEY"]
  },
  "vars": {
    "LOG_LEVEL": "info",
    "APNS_TOPIC": "app.huanan.lumi"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
